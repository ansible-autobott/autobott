# {{ ansible_managed }}
# Sample landing page: nginx serving a static page from a ConfigMap, behind a host-less Ingress with the
# lowest priority, so it answers every request no other Ingress matches. See roles/k3s/About.md.
---
apiVersion: v1
kind: Namespace
metadata:
  name: autobott-sample
  labels:
    pod-security.kubernetes.io/enforce: restricted
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: sample-content
  namespace: autobott-sample
data:
  index.html: |
{{ lookup('ansible.builtin.template', 'sample-index.html.j2') | indent(4, first=true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sample
  namespace: autobott-sample
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: sample
  template:
    metadata:
      labels:
        app.kubernetes.io/name: sample
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: nginx
          image: docker.io/nginxinc/nginx-unprivileged:{{ k3s_config.sample_nginx_version }}
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /
              port: http
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: content
              mountPath: /usr/share/nginx/html
              readOnly: true
            # nginx-unprivileged keeps its pid file and temp dirs in /tmp
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: content
          configMap:
            name: sample-content
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: sample
  namespace: autobott-sample
spec:
  selector:
    app.kubernetes.io/name: sample
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: sample
  namespace: autobott-sample
  annotations:
    # lowest priority: any other Ingress that matches the request wins
    traefik.ingress.kubernetes.io/router.priority: "1"
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: sample
                port:
                  name: http
---
# Only Traefik may reach the sample pod
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-traefik
  namespace: autobott-sample
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - port: 8080
