# {{ ansible_managed }}
# Overrides of the values of the Traefik chart that k3s installs. Empty values ({}) when nothing is overridden:
# k3s does not delete resources when their manifest file is removed. See roles/k3s/About.md.
---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
{% if k3s_config.https_redirect | bool %}
    ports:
      web:
        redirections:
          entryPoint:
            to: websecure
            scheme: https
            permanent: true
{% else %}
    {}
{% endif %}
