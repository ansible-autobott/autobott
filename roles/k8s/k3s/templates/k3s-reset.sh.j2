#!/bin/sh
# {{ ansible_managed }}
# k3s-reset.sh - Reset k3s cluster (wipes all data, keeps binary and config)

[ $(id -u) -eq 0 ] || exec sudo $0 $@

set -ex

/usr/local/bin/k3s-killall.sh

rm -rf /var/lib/rancher/k3s/server/db
rm -rf /var/lib/rancher/k3s/server/tls
rm -rf /var/lib/cni
rm -rf /etc/cni/net.d

systemctl start k3s

{ set +x; } 2>/dev/null
echo
echo "The cluster is reset: it is empty and has a new CA. App data in the volumes' host folders is untouched."
echo "Run autobott-k8s again: it reads the new CA, creates its deploy account again and redeploys the apps."
