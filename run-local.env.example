# ---------------------------------------------------------------------------
# run-local.env — local, git-ignored convenience config for `make run-local`.
#
# Copy this file and edit the values:
#     cp run-local.env.example run-local.env
#
# Then, instead of:
#     make run INV=../inventory/main.yaml HOST=myhost TAG=role_docker
# simply run:
#     make run-local
#
# This file is sourced as shell environment variables by the `run-local`
# target, so keep every line in `KEY=value` form (no spaces around `=`), and
# quote any value that contains spaces (e.g. EXTRA_ARGS below).
# ---------------------------------------------------------------------------

# Inventory (REQUIRED). Path to an inventory FILE or DIRECTORY, relative to the
# repo root. The sops age key is looked up beside it as <inventory-dir>/sops_key
# (override with SOPS_AGE_KEY_FILE below if it lives somewhere else).
INV=../inventory/main.yaml

# Limit the run to a host or group (optional; maps to ansible-playbook -l).
HOST=myhost

# Tag(s) to run (optional; maps to ansible-playbook -t). Comma-separate for
# several, e.g. TAG=role_docker,role_caddy. Leave unset to run everything.
TAG=role_docker

# Extra ansible-playbook arguments (optional), passed through verbatim.
# Quote the value when it has spaces: EXTRA_ARGS="--check --diff"  (dry run);
# a single flag needs no quotes: EXTRA_ARGS=-vvv
#EXTRA_ARGS=

# Explicit sops age key path (optional). Only needed when the key is NOT at
# <inventory-dir>/sops_key.
#SOPS_AGE_KEY_FILE=/path/to/sops_key
